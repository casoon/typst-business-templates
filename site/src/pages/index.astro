---
import {
  Badge,
  Badges,
  BuildOutput,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import tools from '../../../tool-versions.json';
import { url } from '@casoon/pages-theme/lib/url.ts';
import { example } from '../showcase';

const hero = example('invoice-us');
// brochure shares publication/default.typ rather than having its own folder.
const templateCount = Object.keys(import.meta.glob('../../../templates/*/default.typ', { query: '?raw' })).length + 1;
const schemaCount = Object.keys(import.meta.glob('../../../schema/*.schema.json')).length;
const invoiceGallery = ['invoice-de', 'invoice-en', 'invoice-fr', 'invoice-es', 'invoice-it', 'invoice-nl', 'invoice-pt', 'invoice-us'].map(example);
const gallery = ['publication-guide', 'publication-intake', 'publication-brochure', 'credentials', 'concept', 'diagram-roadmap'].map(example);

const quickstart = `cd examples/invoice-languages
typstgen prepare-invoice \\
  --config en-US/invoice-config.json \\
  en-US/invoice.json > en-US/resolved.json
typstgen compile invoice.typ \\
  --input resolved=en-US/resolved.json \\
  -o en-US/invoice.pdf`;
---

<Base>
  <Hero
    title="Configurable invoices and business documents."
    lead="Create invoices in seven languages with explicit VAT or sales-tax configuration. Reuse your company data and logo across offers, contracts, printable forms and brochures."
  >
    <Install
      label="Get the examples"
      commands={[
        { label: 'repository', command: 'git clone https://github.com/casoon/typst-business-templates' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>{config.version} development package</Badge>
      <Badge>Typst 0.15</Badge>
      <Badge>pinned typstgen source build</Badge>
    </Badges>
    <figure slot="output" class="hero-doc">
      <a href={url(`showcase/${hero.slug}/`)}>
        <img
          src={url(`showcase/${hero.slug}.webp`)}
          width={hero.size.width}
          height={hero.size.height}
          alt={hero.alt}
          fetchpriority="high"
        />
      </a>
      <figcaption>
        US Letter · USD · separate sales-tax components · shared SVG logo.
      </figcaption>
    </figure>
  </Hero>

  <Facts
    items={[
      { value: String(templateCount), label: 'document templates' },
      { value: '7', label: 'invoice and document languages' },
      { value: String(invoiceGallery.length), label: 'editable invoice demos with PDFs' },
      { value: String(schemaCount), label: 'JSON schemas for data and configuration' },
    ]}
  />

  <section class="readiness" aria-label="Development status">
    <p>
      The package is development source. Configured invoices require the pinned typstgen build;
      the published {tools.typstgen} compiler supports the existing plain-template path.{' '}
      <a href={url('docs/getting-started/installation/')}>Installation options</a> ·
      <a href={url('docs/reference/project-status/')}>Capabilities and limits</a>
    </p>
  </section>

  <Features
    items={[
      {
        title: 'One configuration for invoice construction',
        body: 'Choose named taxes, required fields, notes, language, number format, currency and paper. typstgen calculates missing totals and checks supplied values. You select the applicable treatment; an address does not choose it for you.',
      },
      {
        title: 'VAT and explicit sales-tax components',
        body: 'Keep taxable, zero, exempt and reverse-charge categories separate. Sales-tax configurations give each component its own taxable basis and rounded amount, with US labels and payment fields.',
      },
      {
        title: 'Shared values for PDF and VAT XML',
        body: 'The existing CII/Factur-X adapter uses the canonical VAT invoice data. External Mustang and PDF/A checks exercise the supported examples. XRechnung, Peppol and transmission remain outside the implemented adapters.',
      },
      {
        title: 'Compact publications and printable forms',
        body: 'Build A4 guides and intake forms with labelled writing fields, choices, notes, phases and tables. Use landscape brochures for short overviews. Credentials can mask passwords, and partial locale overrides retain package defaults.',
      },
      {
        title: 'Typst content and chartlet diagrams',
        body: 'Write contracts, concepts and documentation as Typst markup. Reuse company data and branding; add flow charts, timelines and architecture diagrams rendered by chartlet.',
      },
    ]}
  />

  <BuildOutput
    heading="Seven languages, plus a US variant"
    caption="Eight real invoice PDFs from one shared template, each with editable configuration, invoice data and a fictional SVG logo. Tax rates and company details are illustrative, not national tax presets."
    file="examples/invoice-languages/"
  >
    <ul class="gallery">
      {invoiceGallery.map((doc) => (
        <li>
          <a href={url(`showcase/${doc.slug}/`)}>
            <img src={url(`showcase/${doc.slug}.webp`)} width={doc.size.width} height={doc.size.height}
              alt={doc.alt} loading="lazy" decoding="async" />
            <span>{doc.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </BuildOutput>

  <BuildOutput
    heading="Guides, forms and other documents"
    caption="Outputs from the example projects: compact publications, printable forms, landscape brochures, credentials, concepts and chartlet diagrams. Each entry includes its source and full PDF."
    file="examples/"
  >
    <ul class="gallery">
      {
        gallery.map((doc) => (
          <li>
            <a href={url(`showcase/${doc.slug}/`)}>
              <img
                src={url(`showcase/${doc.slug}.webp`)}
                width={doc.size.width}
                height={doc.size.height}
                alt={doc.alt}
                loading="lazy"
                decoding="async"
              />
              <span>{doc.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </BuildOutput>

  <Quickstart
    lead="Install the pinned development compiler from the documentation, then prepare and render an existing language demo. The same configuration path works in the CLI, Rust library and MCP."
    steps={[
      'Choose a demo and install the coordinated typstgen revision from <code>tool-versions.json</code>.',
      'Edit the demo’s invoice configuration and input: company, customer, descriptions and selected tax keys.',
      'Prepare canonical invoice values and compile the shared wrapper. VAT invoices can also use the existing Factur-X path.',
    ]}
  >
    <CodeBlock code={quickstart} lang="shell" title="terminal" label="Shell" />
  </Quickstart>
</Base>

<style>
  .readiness {
    max-width: var(--max);
    margin: -36px auto 48px;
    padding: 0 24px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }
  .readiness a { color: var(--heading); text-decoration: underline; }

  .hero-doc {
    max-width: 440px;
    margin: 0 auto;
  }
  .hero-doc img,
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .hero-doc figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    align-items: start;
    gap: 24px;
    margin: 0;
    padding: 24px;
    list-style: none;
  }
  .gallery a {
    display: block;
    color: var(--heading);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .gallery span {
    display: block;
    margin-top: 10px;
  }
  .gallery a:hover span {
    text-decoration: underline;
  }
</style>
