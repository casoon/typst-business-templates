---
import {
  Badge,
  Badges,
  BuildOutput,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/lib/url.ts';
import { example } from '../showcase';

// brochure shares publication/default.typ rather than having its own folder.
const templateCount = Object.keys(import.meta.glob('../../../templates/*/default.typ', { query: '?raw' })).length + 1;
const schemaCount = Object.keys(import.meta.glob('../../../schema/*.schema.json')).length;
const invoiceGallery = ['invoice-de', 'invoice-en', 'invoice-fr', 'invoice-es', 'invoice-it', 'invoice-nl', 'invoice-pt', 'invoice-us'].map(example);
const gallery = ['publication-guide', 'publication-intake', 'publication-brochure', 'credentials', 'concept', 'diagram-roadmap'].map(example);

const quickstart = `git clone https://github.com/casoon/typst-business-templates
cd typst-business-templates
python3 examples/invoice-languages/build.py`;
---

<Base>
  <Hero
    layout="editorial"
    title="Deterministic PDFs from JSON and Typst."
    lead="Use structured JSON data and reusable Typst templates to generate standardized business PDFs. Fix the data, templates, fonts, assets, compiler version and build timestamp for reproducible output."
  >
    <div class="hero-actions">
      <Button href={url('showcase/')}>View PDF examples</Button>
      <Button href={url('docs/guides/json-documents/')} variant="secondary">Start with JSON</Button>
    </div>
    <Badges>
      <Badge>MIT</Badge>
      <Badge>{config.version} development package</Badge>
    </Badges>
    <figure slot="output" class="workflow">
      <picture class="workflow-light">
        <source media="(max-width: 640px)" srcset={url('diagrams/document-build-narrow-light.svg')} width="360" height="420" />
        <img src={url('diagrams/document-build-wide-light.svg')} width="900" height="320"
          alt="JSON data and a reusable Typst template, with fixed build inputs, are compiled by typstgen into a standardized PDF."
          fetchpriority="high" />
      </picture>
      <picture class="workflow-dark">
        <source media="(max-width: 640px)" srcset={url('diagrams/document-build-narrow-dark.svg')} width="360" height="420" />
        <img src={url('diagrams/document-build-wide-dark.svg')} width="900" height="320"
          alt="JSON data and a reusable Typst template, with fixed build inputs, are compiled by typstgen into a standardized PDF." />
      </picture>
      <figcaption>
        Pin the data, templates, fonts, assets, compiler and timestamp to reproduce a build.
      </figcaption>
    </figure>
  </Hero>

  <Facts
    items={[
      { value: String(templateCount), label: 'document templates' },
      { value: String(schemaCount), label: 'JSON schemas for structured input' },
      { value: 'JSON + Typst', label: 'data and layout kept in versionable files' },
    ]}
  />

  <section class="readiness" aria-label="Development status">
    <p>
      This is a development package. Use the documented compiler version to rebuild the examples.{' '}
      <a href={url('docs/getting-started/installation/')}>Setup guide</a>{' · '}
      <a href={url('docs/reference/project-status/')}>What is supported</a>
    </p>
  </section>

  <section class="toolchain" aria-labelledby="toolchain-title">
    <h2 id="toolchain-title">The templates and the compiler</h2>
    <div class="toolchain-roles">
      <div>
        <h3>business-templates — this repository</h3>
        <p>Reusable Typst layouts, JSON schemas, translations and editable examples.
          Your data and these templates define the document.</p>
        <a href={url('docs/reference/package/')}>Explore the template package →</a>
      </div>
      <div>
        <h3>typstgen — a separate project</h3>
        <p>The PDF builder, with the Typst compiler embedded. Use its CLI, Rust library
          or MCP server to compile your documents. Its coordinated source build also
          prepares configured invoices and calculates their totals.</p>
        <a href="https://casoon.github.io/typstgen/">Explore typstgen →</a>{' · '}
        <a href="https://github.com/casoon/typstgen">GitHub repository</a>
      </div>
    </div>
    <p class="toolchain-setup">Install the compiler separately using the{' '}
      <a href={url('docs/getting-started/installation/')}>setup guide</a>.
      Configured invoices require the pinned source revision documented there.</p>
  </section>

  <Features
    items={[
      {
        title: 'One layout, standardized documents',
        body: 'Define the document in a reusable Typst template and load structured content and company data from JSON. Version the source files and repeat the same build for each document.',
      },
      {
        title: 'Invoice in the language your client reads',
        body: 'Choose from seven invoice languages, A4 or US Letter, and separate currency and number formats. Supply your own descriptions and notes; translated labels come from the package.',
      },
      {
        title: 'Keep invoice amounts consistent',
        body: 'Calculate line amounts and tax totals from the rates you configure, and check any totals you supply. VAT invoices can use the same values for PDF and Factur-X XML; sales-tax components are listed separately.',
      },
      {
        title: 'Guides, forms and project documents',
        body: 'Use 21 templates for business correspondence and project work. Assemble compact guides, printable intake forms and landscape brochures with reusable Typst components.',
      },
      {
        title: 'Fit document generation into your project',
        body: 'Keep JSON data and Typst sources in Git. Compile with the CLI, integrate through Rust or use MCP tools for checking and previews. Add chartlet diagrams when your documents need them.',
      },
    ]}
  />

  <BuildOutput
    heading="Seven languages, plus a US variant"
    caption="Eight real invoice PDFs from one shared template, each with editable configuration, invoice data and a fictional SVG logo. Tax rates and company details are illustrative, not national tax presets."
    file="examples/invoice-languages/"
  >
    <ul class="gallery">
      {invoiceGallery.map((doc) => (
        <li>
          <a href={url(`showcase/${doc.slug}/`)}>
            <img src={url(`showcase/${doc.slug}.webp`)} width={doc.size.width} height={doc.size.height}
              alt={doc.alt} loading="lazy" decoding="async" />
            <span>{doc.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </BuildOutput>

  <BuildOutput
    heading="Guides, forms and other documents"
    caption="Outputs from the example projects: compact publications, printable forms, landscape brochures, credentials, concepts and chartlet diagrams. Each entry includes its source and full PDF."
    file="examples/"
  >
    <ul class="gallery">
      {
        gallery.map((doc) => (
          <li>
            <a href={url(`showcase/${doc.slug}/`)}>
              <img
                src={url(`showcase/${doc.slug}.webp`)}
                width={doc.size.width}
                height={doc.size.height}
                alt={doc.alt}
                loading="lazy"
                decoding="async"
              />
              <span>{doc.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </BuildOutput>

  <Quickstart
    title="Make an example your own"
    lead="Open a PDF first, then edit its data and configuration. Install the compiler from the setup guide before rebuilding the examples."
    steps={[
      'Choose a PDF example and open the configuration and invoice data alongside it.',
      'Replace the sample company details, logo and descriptions, then choose the taxes and language your invoice needs.',
      'Rebuild the PDFs with the documented compiler and keep the editable inputs with your project.',
    ]}
  >
    <CodeBlock code={quickstart} lang="shell" title="terminal" label="Shell" />
  </Quickstart>
</Base>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    width: 100%;
  }

  .readiness {
    max-width: var(--max);
    margin: -36px auto 48px;
    padding: 0 24px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }
  .readiness a { color: var(--heading); text-decoration: underline; }

  .toolchain {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  .toolchain h2 { margin: 0 0 24px; color: var(--heading); font-size: 28px; }
  .toolchain-roles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 28px 48px;
  }
  .toolchain-roles > div { border-top: 1px solid var(--border); padding-top: 20px; }
  .toolchain h3 { margin: 0 0 8px; color: var(--heading); font-size: 17px; }
  .toolchain p { font-size: 14.5px; line-height: 1.65; }
  .toolchain-roles p { margin: 0 0 12px; }
  .toolchain a { color: var(--heading); text-decoration: underline; }
  .toolchain-roles a { font-size: 14.5px; }
  .toolchain-setup { margin: 24px 0 0; color: var(--muted); }

  .workflow {
    margin: 0;
  }
  .workflow picture {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .workflow-light { display: block; }
  .workflow-dark { display: none; }
  :global(:root[data-theme='dark']) .workflow-light { display: none; }
  :global(:root[data-theme='dark']) .workflow-dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .workflow-light { display: none; }
    :global(:root:not([data-theme='light'])) .workflow-dark { display: block; }
  }
  .workflow img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 320;
  }
  .workflow figcaption {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .workflow img { aspect-ratio: 360 / 420; }
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    align-items: start;
    gap: 24px;
    margin: 0;
    padding: 24px;
    list-style: none;
  }
  .gallery a {
    display: block;
    color: var(--heading);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .gallery span {
    display: block;
    margin-top: 10px;
  }
  .gallery a:hover span {
    text-decoration: underline;
  }
</style>
