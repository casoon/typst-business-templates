---
import {
  Badge,
  Badges,
  BuildOutput,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import tools from '../../../tool-versions.json';
import { url } from '@casoon/pages-theme/lib/url.ts';
import { example } from '../showcase';

const hero = example('invoice');
const gallery = ['offer', 'reminder', 'letter', 'credentials', 'concept', 'diagram-roadmap'].map(example);

const quickstart = `cargo install typstgen
git clone https://github.com/casoon/typst-business-templates
cd typst-business-templates/examples/it-consultant
typstgen compile documents/invoices/2025/invoice.typ
# → documents/invoices/2025/invoice.pdf
typstgen compile documents/invoices/2025/invoice.typ \\
  --zugferd documents/invoices/2025/invoice.json \\
  --company data/company.json --pdf-standard a-3b
# → the same PDF as ZUGFeRD e-invoice`;
---

<Base>
  <Hero
    title="Business documents as a Typst package."
    lead="Templates for invoices, offers, reminders, letters, credentials, concepts, contracts and more. Keep invoices as JSON and long documents as Typst markup; typstgen compiles them to PDF with your company data and turns invoices into ZUGFeRD e-invoices."
  >
    <Install
      label="Install"
      commands={[
        { label: 'typstgen', command: 'cargo install typstgen' },
        { label: 'package', command: 'git clone https://github.com/casoon/typst-business-templates' },
        { label: 'diagrams', command: 'cargo install chartlet' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>business-templates {config.version}</Badge>
      <Badge>Typst 0.15</Badge>
      <Badge>typstgen {tools.typstgen}</Badge>
    </Badges>
    <figure slot="output" class="hero-doc">
      <a href={url(`showcase/${hero.slug}/`)}>
        <img
          src={url(`showcase/${hero.slug}.webp`)}
          width={hero.size.width}
          height={hero.size.height}
          alt={hero.alt}
          fetchpriority="high"
        />
      </a>
      <figcaption>
        First page of <code>{hero.file.replace('examples/', '')}</code>, compiled by typstgen 0.5.0.
      </figcaption>
    </figure>
  </Hero>

  <Facts
    items={[
      { value: '19', label: 'document templates' },
      { value: '7', label: 'languages for concepts, contracts and other documents' },
      { value: 'EN 16931', label: 'e-invoices built by typstgen' },
      { value: '11', label: 'JSON schemas for data files' },
    ]}
  />

  <Features
    items={[
      {
        title: 'Your documents are plain files',
        body: 'Invoices and offers are JSON with a four-line Typst file next to them, long documents are Typst markup. Company data is one company.json. Everything diffs and versions in Git.',
      },
      {
        title: 'German business conventions built in',
        body: 'DIN 5008 address block, VAT breakdown, dunning levels and a company footer with tax and bank data. Kleinunternehmer invoices print the § 19 UStG note, and totals that do not add up stop the build.',
      },
      {
        title: 'E-invoices from the same data',
        body: 'typstgen builds the ZUGFeRD / Factur-X XML (EN 16931) from the invoice JSON and embeds it in a PDF/A-3. The template sets the document date the standard requires.',
      },
      {
        title: 'Diagrams with chartlet',
        body: 'Flow charts, org charts, timelines and architecture diagrams come from a JSON spec, rendered to SVG by chartlet and placed in any document like an image.',
      },
    ]}
  />

  <BuildOutput
    heading="Compiled by typstgen"
    caption="First pages of documents from the example projects, compiled by typstgen 0.5.0; diagrams rendered by chartlet 0.19. Each links to its source file and the full PDF."
    file="examples/"
  >
    <ul class="gallery">
      {
        gallery.map((doc) => (
          <li>
            <a href={url(`showcase/${doc.slug}/`)}>
              <img
                src={url(`showcase/${doc.slug}.webp`)}
                width={doc.size.width}
                height={doc.size.height}
                alt={doc.alt}
                loading="lazy"
                decoding="async"
              />
              <span>{doc.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </BuildOutput>

  <Quickstart
    lead="From a clone to a PDF and an e-invoice. The example projects point typstgen at the package and the fonts in the repository; the documentation shows how to set up your own project."
    steps={[
      'Install <code>typstgen</code> with Cargo.',
      'Clone the repository and open an example project, or set up your own with a <code>typstgen.toml</code> and <code>data/company.json</code>.',
      'Run <code>typstgen compile</code> on a document; add <code>--zugferd</code> for an e-invoice.',
    ]}
  >
    <CodeBlock code={quickstart} lang="shell" title="terminal" label="Shell" />
  </Quickstart>
</Base>

<style>
  .hero-doc {
    max-width: 440px;
    margin: 0 auto;
  }
  .hero-doc img,
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .hero-doc figcaption {
    margin-top: 12px;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    align-items: start;
    gap: 24px;
    margin: 0;
    padding: 24px;
    list-style: none;
  }
  .gallery a {
    display: block;
    color: var(--heading);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .gallery span {
    display: block;
    margin-top: 10px;
  }
  .gallery a:hover span {
    text-decoration: underline;
  }
</style>
