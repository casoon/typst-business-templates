---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  BuildOutput,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/lib/url';
import { example } from '../showcase';
import toolVersions from '../../../tool-versions.json';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

// brochure shares publication/default.typ rather than having its own folder.
const templateCount = Object.keys(import.meta.glob('../../../templates/*/default.typ', { query: '?raw' })).length + 1;
const schemaCount = Object.keys(import.meta.glob('../../../schema/*.schema.json')).length;
const invoiceGallery = ['invoice-de', 'invoice-en', 'invoice-fr', 'invoice-es', 'invoice-it', 'invoice-nl', 'invoice-pt', 'invoice-us'].map(example);
const gallery = ['publication-guide', 'publication-intake', 'publication-brochure', 'credentials', 'concept', 'diagram-roadmap'].map(example);

const quickstart = `cargo install typstgen --version ${toolVersions.typstgen} --locked
git clone --branch templates-v0.2.0 https://github.com/casoon/typst-business-templates
cd typst-business-templates && ./scripts/install-package.sh
python3 examples/invoice-languages/build.py`;
---

<Base>
  <Hero
    layout="editorial"
    title="Deterministic PDFs from JSON and Typst."
    lead="Use structured JSON data and reusable Typst templates to generate standardized business PDFs. Fix the data, templates, fonts, assets, compiler version and build timestamp for reproducible output."
  >
    <div class="hero-actions">
      <Button href={url('showcase/')}>View PDF examples</Button>
      <Button href={url('docs/guides/json-documents/')} variant="secondary">Start with JSON</Button>
    </div>
    <Badges>
      <Badge>MIT</Badge>
      <Badge>{config.version} template package</Badge>
    </Badges>
    <figure slot="output" class="workflow">
      <picture class="workflow-light">
        <source media="(max-width: 640px)" srcset={url('diagrams/document-build-narrow-light.svg')} width="360" height="420" />
        <img src={url('diagrams/document-build-wide-light.svg')} width="900" height="320"
          alt="JSON data and a reusable Typst template, with fixed build inputs, are compiled by typstgen into a standardized PDF."
          fetchpriority="high" />
      </picture>
      <picture class="workflow-dark">
        <source media="(max-width: 640px)" srcset={url('diagrams/document-build-narrow-dark.svg')} width="360" height="420" />
        <img src={url('diagrams/document-build-wide-dark.svg')} width="900" height="320"
          alt="JSON data and a reusable Typst template, with fixed build inputs, are compiled by typstgen into a standardized PDF." />
      </picture>
      <figcaption>
        Pin the data, templates, fonts, assets, compiler and timestamp to reproduce a build.
      </figcaption>
    </figure>
  </Hero>

  <Facts
    items={[
      { value: String(templateCount), label: 'document templates' },
      { value: String(schemaCount), label: 'JSON schemas for structured input' },
      { value: 'JSON + Typst', label: 'data and layout kept in versionable files' },
    ]}
  />

  <section class="readiness" aria-label="Package version and compatibility">
    <p>
      Template package {config.version}. Use the matching source release and documented compiler to rebuild the examples.{' '}
      <a href={url('docs/getting-started/installation/')}>Setup guide</a>{' · '}
      <a href={url('docs/reference/project-status/')}>What is supported</a>
    </p>
  </section>

  <section class="toolchain" aria-labelledby="toolchain-title">
    <h2 id="toolchain-title">The templates and the compiler</h2>
    <div class="toolchain-roles">
      <div>
        <h3>business-templates: this repository</h3>
        <p>Reusable Typst layouts, JSON schemas, translations and editable examples.
          Your data and these templates define the document.</p>
        <a href={url('docs/reference/package/')}>Explore the template package →</a>
      </div>
      <div>
        <h3>typstgen: a separate project</h3>
        <p>The PDF builder, with the Typst compiler embedded. Use its CLI, Rust library
          or MCP server to compile your documents. Since 0.6.0 it also
          prepares configured invoices, calculates their totals and writes XRechnung/Peppol files.</p>
        <a href="https://casoon.github.io/typstgen/">Explore typstgen →</a>{' · '}
        <a href="https://github.com/casoon/typstgen">GitHub repository</a>
      </div>
    </div>
    <p class="toolchain-setup">Install it with{' '}
      <code>cargo install typstgen --version {toolVersions.typstgen} --locked</code>; the{' '}
      <a href={url('docs/getting-started/installation/')}>setup guide</a> has the remaining two steps.</p>
  </section>

  <Features
    items={[
      {
        title: 'One layout, standardized documents',
        body: 'Define the document in a reusable Typst template and load structured content and company data from JSON. Version the source files and repeat the same build for each document.',
      },
      {
        title: 'Invoice in the language your client reads',
        body: 'Choose from seven invoice languages, A4 or US Letter, and separate currency and number formats. Supply your own descriptions and notes; translated labels come from the package.',
      },
      {
        title: 'Keep invoice amounts consistent',
        body: 'Calculate line amounts and tax totals from the rates you configure, and check any totals you supply. VAT invoices can use the same values for PDF and Factur-X XML; sales-tax components are listed separately.',
      },
      {
        title: 'Guides, forms and project documents',
        body: 'Use 21 templates for business correspondence and project work. Assemble compact guides, printable intake forms and landscape brochures with reusable Typst components.',
      },
      {
        title: 'Fit document generation into your project',
        body: 'Keep JSON data and Typst sources in Git. Compile with the CLI or integrate through Rust. Add chartlet diagrams when your documents need them.',
      },
    ]}
  />

  <section class="toolchain agent-workflow" aria-labelledby="agent-title">
    <h2 id="agent-title">Let your AI assistant check the document it builds</h2>
    <p>Connect an MCP-compatible assistant to typstgen’s local Model Context Protocol server.
      The assistant edits your JSON or Typst files using its editor tools, then asks typstgen
      to check the source, show a page preview and write the PDF.</p>
    <ol class="agent-steps">
      <li><h3>Check</h3><p>Get compiler errors and warnings with file and line references.</p></li>
      <li><h3>Preview</h3><p>Inspect a rendered page to spot table overflow and awkward page breaks.</p></li>
      <li><h3>Compile</h3><p>Save the PDF using the same templates, data and fixed build inputs.</p></li>
    </ol>
    <blockquote>“Check the letter, show me the first page, then save the PDF with a fixed build timestamp.”</blockquote>
    <p>The model proposes edits; the Typst compiler renders the result. Review the data and preview
      before using the final document.</p>
    <a href={url('docs/guides/ai-agents/')}>Set up MCP with these templates →</a>{' · '}
    <a href="https://casoon.github.io/typstgen/docs/guides/ai-agents/#in-practice">Watch typstgen’s MCP walkthrough</a>
  </section>

  <BuildOutput
    heading="Seven invoice languages, plus a US variant"
    caption="Eight real invoice PDFs from one shared template, each with editable configuration, invoice data and a fictional SVG logo. Seven-language labels apply to invoices; other templates have their own language support. Tax rates and company details are illustrative, not national tax presets."
    file="examples/invoice-languages/"
  >
    <ul class="gallery">
      {invoiceGallery.map((doc) => (
        <li>
          <a href={url(`showcase/${doc.slug}/`)}>
            <img src={url(`showcase/${doc.slug}.webp`)} width={doc.size.width} height={doc.size.height}
              alt={doc.alt} loading="lazy" decoding="async" />
            <span>{doc.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </BuildOutput>

  <BuildOutput
    heading="Guides, forms and other documents"
    caption="Outputs from the example projects: compact publications, printable forms, landscape brochures, credentials, concepts and chartlet diagrams. Each entry includes its source and full PDF."
    file="examples/"
  >
    <ul class="gallery">
      {
        gallery.map((doc) => (
          <li>
            <a href={url(`showcase/${doc.slug}/`)}>
              <img
                src={url(`showcase/${doc.slug}.webp`)}
                width={doc.size.width}
                height={doc.size.height}
                alt={doc.alt}
                loading="lazy"
                decoding="async"
              />
              <span>{doc.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </BuildOutput>

  <Quickstart
    title="Make an example your own"
    lead="Start with a letter, project document or invoice in the showcase. Follow the setup guide to install typstgen and the template package. The command below rebuilds the invoice demos."
    steps={[
      'Choose a PDF example and open its linked Typst source or JSON data.',
      'Replace the sample company details, logo and content. For invoices, also configure taxes, language and paper.',
      'Build with the CLI or ask your MCP-connected assistant to check, preview and compile. Keep the inputs and build settings with your project.',
    ]}
  >
    <CodeBlock code={quickstart} lang="shell" title="terminal" label="Shell" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Is business-templates published on Typst Universe?',
        a: 'No. It is distributed as a source release tag (currently templates-v0.2.0) and installed locally as @local/business-templates; clone the tagged repository rather than fetching a package.',
      },
      {
        q: 'Do I need typstgen to use these templates?',
        a: 'Yes. This repository holds only the Typst package, JSON schemas and examples; typstgen is the separate project that provides the CLI, Rust library and MCP server with the Typst compiler embedded.',
      },
      {
        q: 'Are the example tax rates and company details usable as-is?',
        a: 'No. The businesses, accounts and tax rates in the language demos are fictional, and a language demo is not a reviewed national tax preset. Optional reviewed profiles exist separately for cases that need them.',
      },
      {
        q: 'What happened to the old docgen CLI and Rust crate?',
        a: 'They are discontinued. This repository is now the standalone Typst package, and client/project management, numbering and the former --encrypt option were not carried over. Historical tags keep their original meaning.',
      },
      {
        q: 'Can an AI assistant check and compile the documents for me?',
        a: 'Yes, through MCP. Connect an MCP-compatible assistant to typstgen’s local server so it can check the Typst source, inspect a page preview and compile the PDF while you edit the JSON or Typst inputs.',
      },
    ]}
  />
</Base>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    width: 100%;
  }

  .readiness {
    max-width: var(--max);
    margin: -36px auto 48px;
    padding: 0 24px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }
  .readiness a { color: var(--heading); text-decoration: underline; }

  .toolchain {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  .toolchain h2 { margin: 0 0 24px; color: var(--heading); font-size: 28px; }
  .toolchain-roles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 28px 48px;
  }
  .toolchain-roles > div { border-top: 1px solid var(--border); padding-top: 20px; }
  .toolchain h3 { margin: 0 0 8px; color: var(--heading); font-size: 17px; }
  .toolchain p { font-size: 14.5px; line-height: 1.65; }
  .toolchain-roles p { margin: 0 0 12px; }
  .toolchain a { color: var(--heading); text-decoration: underline; }
  .toolchain-roles a { font-size: 14.5px; }
  .toolchain-setup { margin: 24px 0 0; color: var(--muted); }
  .agent-workflow > p { max-width: 78ch; }
  .agent-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 28px 48px;
    padding: 0;
    margin: 28px 0;
    list-style-position: inside;
  }
  .agent-steps li { border-top: 1px solid var(--border); padding-top: 20px; }
  .agent-steps h3 { display: inline; }
  .agent-steps p { margin: 8px 0 0; }
  .agent-workflow blockquote {
    margin: 28px 0;
    color: var(--heading);
    font-size: 20px;
    line-height: 1.5;
  }

  .workflow {
    margin: 0;
  }
  .workflow picture {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }
  .workflow-light { display: block; }
  .workflow-dark { display: none; }
  :global(:root[data-theme='dark']) .workflow-light { display: none; }
  :global(:root[data-theme='dark']) .workflow-dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .workflow-light { display: none; }
    :global(:root:not([data-theme='light'])) .workflow-dark { display: block; }
  }
  .workflow img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 320;
  }
  .workflow figcaption {
    margin-top: 14px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .workflow img { aspect-ratio: 360 / 420; }
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    align-items: start;
    gap: 24px;
    margin: 0;
    padding: 24px;
    list-style: none;
  }
  .gallery a {
    display: block;
    color: var(--heading);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .gallery span {
    display: block;
    margin-top: 10px;
  }
  .gallery a:hover span {
    text-decoration: underline;
  }
</style>
