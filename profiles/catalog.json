          }
        },
        {
          "path": "data.recipient.vat_id",
          "labels": {
            "fr": "TVA client",
            "en": "Buyer VAT ID"
          }
        },
        {
          "path": "facts.supply_kind",
          "labels": {
            "fr": "Nature de l’opération",
            "en": "Supply kind"
          }
        },
        {
          "path": "data.payment.early_payment_discount",
          "labels": {
            "fr": "Escompte",
